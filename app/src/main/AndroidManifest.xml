<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" />
    <!-- The 保存復元 automation contract may name any absolute directory for the backup ZIP. -->
    <uses-permission
        android:name="android.permission.MANAGE_EXTERNAL_STORAGE"
        tools:ignore="ScopedStorage" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <!-- The 保存復元 data door streams an archive through a caller-supplied descriptor in a
         foreground service; at targetSdk 34+ the specialUse type needs its permission as well. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />

    <!-- Package visibility for the two 保存復元 callers. Without this, `setPackage` on our reply
         broadcast fails SILENTLY on Android 11+ — the export runs, writes correctly and is never
         heard of — and the data door cannot read a caller's signing certificate, so a legitimate
         call is refused as "signature unreadable". This fork had no <queries> element at all until
         2026-09-04, so its §1 replies had been discarded for as long as the receiver existed.
         BOTH callers, always: 応用管理 restores, but 自由作業盤 is what drives the §1 batch. -->
    <queries>
        <package android:name="shiroikuma.oyokanri" />
        <package android:name="shiroikuma.jiyusagyoban" />
    </queries>

    <uses-sdk tools:overrideLibrary="androidx.browser,com.google.firebase.iid"/>
    <application
        android:name="com.github.premnirmal.ticker.StocksApp"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:theme="@style/StocksWidget.App.Theme"
        tools:replace="android:icon">

        <activity
            android:exported="true"
            android:name="com.github.premnirmal.ticker.home.HomeActivity"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustPan"
            android:theme="@style/Theme.App.Starting">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <action android:name="android.intent.action.VIEW" />
            </intent-filter>
        </activity>
        <activity
            android:name="com.github.premnirmal.ticker.portfolio.HoldingsActivity"
            android:label="@string/add_position"
            android:theme="@style/AddPositionTheme"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name="com.github.premnirmal.ticker.portfolio.NotesActivity"
            android:label="@string/add_notes"
            android:theme="@style/AddPositionTheme"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name="com.github.premnirmal.ticker.portfolio.DisplaynameActivity"
            android:label="@string/add_displayname"
            android:theme="@style/AddPositionTheme"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name="com.github.premnirmal.ticker.portfolio.AlertsActivity"
            android:label="@string/add_alerts"
            android:theme="@style/AddPositionTheme"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:exported="true"
            android:name="com.github.premnirmal.ticker.settings.WidgetSettingsActivity"
            android:label="@string/action_Settings"
            android:theme="@style/WidgetSettingsTheme"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_CONFIGURE" />
            </intent-filter>
        </activity>

        <activity
            android:name="com.github.premnirmal.ticker.news.QuoteDetailActivity"
            android:label="@string/news_feed"
            android:theme="@style/NewsFeedActivityTheme" />

        <activity
            android:name="com.github.premnirmal.ticker.portfolio.search.SearchActivity"
            android:label="@string/action_search"
            android:theme="@style/SearchTheme" />
        <activity
            android:name="com.github.premnirmal.ticker.settings.WebViewActivity"
            android:theme="@style/WebViewTheme" />
        <activity
            android:name="com.github.premnirmal.ticker.debug.DbViewerActivity"
            android:theme="@style/DbViewerTheme" />

        <activity
            android:name="com.github.premnirmal.ticker.settings.UiSettingsActivity"
            android:label="@string/shiroikuma_ui_title"
            android:theme="@style/NewsFeedActivityTheme" />

        <receiver
            android:name="com.github.premnirmal.ticker.UpdateReceiver"
            android:enabled="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>
        <receiver
            android:name="com.github.premnirmal.ticker.widget.RefreshReceiver"
            android:enabled="true" />
        <receiver
            android:name="com.github.premnirmal.ticker.notifications.DailySummaryNotificationReceiver"
            android:enabled="true"
            android:exported="false" />

        <!-- 保存復元 automation: the token is the gate, so no android:permission (callers hold none). -->
        <receiver
            android:name="com.github.premnirmal.ticker.settings.StateExportReceiver"
            android:enabled="true"
            android:exported="true">
            <intent-filter>
                <action android:name="${applicationId}.action.EXPORT_STATE" />
                <action android:name="${applicationId}.action.LIST_CATEGORIES" />
                <!-- The cancel must be reachable from OUTSIDE: the stop path lives behind an
                     unexported service, which a third-party app cannot start, so it is routed
                     through this receiver and signalled internally. -->
                <action android:name="${applicationId}.action.CANCEL_EXPORT" />
            </intent-filter>
        </receiver>

        <!-- 保存復元 v2: the data door. Exported with no permission deliberately — a custom
             permission could only be `normal` (any app may hold it) or `signature` (impossible:
             every app in this family has its own keystore), and neither buys anything the caller
             check in AutomationCallers does not already give. -->
        <provider
            android:name="com.github.premnirmal.ticker.automation.AutomationProvider"
            android:authorities="${applicationId}.automation"
            android:exported="true"
            tools:ignore="ExportedContentProvider" />

        <service
            android:name="com.github.premnirmal.ticker.automation.AutomationDataService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Automation data export/import" />
        </service>

        <!-- Capability discovery. Read across every installed package at once, with
             MATCH_UNINSTALLED_PACKAGES | MATCH_DISABLED_COMPONENTS, because a frozen app cannot be
             asked anything and 白い熊 freezes aggressively. These are INTEGERS: aapt2 stores a bare
             numeric android:value as an int, so the reader uses getInt, not getString. -->
        <meta-data android:name="shiroikuma.automation.contract" android:value="2" />
        <meta-data android:name="shiroikuma.automation.format" android:value="1" />
        <meta-data android:name="shiroikuma.automation.min_format" android:value="1" />

        <!-- Glance Widget -->
        <receiver android:name="com.github.premnirmal.ticker.widget.StockWidget"
            android:exported="true"
            android:label="@string/widget_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget" />
        </receiver>

        <!-- File provider -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.provider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/provider_paths" />
        </provider>

        <meta-data
            android:name="com.crashlytics.ApiKey"
            android:value="856c59cfad291a9403df034e02e90219acfdedb1" />
    </application>

</manifest>
